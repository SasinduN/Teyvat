{
  "name": "teyvat-travel-eye",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "start": "node server/dist/index.js",
    "dev:server": "tsx watch server/src/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "images:audit": "tsx scripts/images-audit.ts",
    "images:import": "tsx scripts/images-import.ts",
    "images:migrate-assets": "tsx scripts/images-migrate-assets.ts",
    "media:rebase": "tsx scripts/media-rebase.ts",
    "test": "node scripts/run-tests.mjs",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "verify:roundtrip": "tsx scripts/verify-roundtrip.ts",
    "bundle:report": "tsx scripts/bundle-report.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.2.1",
    "@tanstack/react-query": "^5.102.8",
    "@types/leaflet": "^1.9.22",
    "aws4fetch": "^1.0.20",
    "clsx": "2.1.1",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "framer-motion": "^13.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.41.0",
    "pg": "^8.13.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.4.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "^5.0.0",
    "@types/node": "22.19.17",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
