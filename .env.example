# ---------------------------------------------------------------------------
# Teyvat / Travel Eye Sri Lanka
# Copy to `.env.local` and fill in with your own project's values.
# `.env.local` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" / publishable key. This key is safe to ship to the browser:
# every table is protected by Row Level Security.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — never add a service_role key with a VITE_ prefix, and
# never import one from `src/`. Vite inlines every VITE_* variable into the
# client bundle, which would publish the key to the world.
#
# The optional image-migration script (scripts/migrate-images.ts) reads this
# from the shell environment, not from .env.local:
#   SUPABASE_SERVICE_ROLE_KEY=... npm run images:migrate
# ---------------------------------------------------------------------------
