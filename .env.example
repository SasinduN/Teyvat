# ---------------------------------------------------------------------------
# Teyvat / Travel Eye Sri Lanka
# Copy to `.env.local` and fill in with your own project's values.
# `.env.local` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Map tiles (CARTO Voyager). The ONE public value here: Vite builds it into
# the page, as every tile key is. It's protected by being restricted to the
# site's domains in the CARTO dashboard, not by being secret. Without it the
# map still renders, but on "API key required" tiles. Read at build time.
# ---------------------------------------------------------------------------
VITE_CARTO_KEY=

# ---------------------------------------------------------------------------
# Everything below is SERVER-SIDE ONLY. Never give a secret a VITE_ prefix and
# never import one from `src/`: Vite inlines every VITE_* variable into the
# client bundle, which would publish it.
# ---------------------------------------------------------------------------

# The database the app and `npm run migrate` use. For development, a local
# one: `createdb teyvat_dev`, then e.g.
#   postgresql://postgres:<password>@localhost:5432/teyvat_dev
# Never point this at production for everyday work. (The production URL is
# only for the owner's one-off scripts: admin:create, images:audit,
# media:rebase. See docs/LAUNCH-CHECKLIST.md.)
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/teyvat_dev
TEST_DATABASE_URL=postgresql://postgres:your-password@localhost:5432/teyvat_test

# ---------------------------------------------------------------------------
# API tests (`npm test`). A local database of their own: the tests empty the
# users, sessions and login_attempts tables. They refuse to run unless this
# points at localhost, includes an explicit port, and names a database ending
# in _test. Use the port your own PostgreSQL listens on.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Image uploads (Cloudflare R2). All five, or none: with none, the site runs
# and uploads say "not configured". Server-side only; never prefix with VITE_.
# The token needs Object Read & Write on this one bucket.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address, https:// (trailing slash optional).
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# New-enquiry emails (Resend). RESEND_API_KEY and NOTIFY_EMAIL_TO together turn
# them on; without them the site runs and the inbox badge still shows new
# enquiries. Until a sending domain is verified, Resend only delivers from its
# test sender to the address the Resend account was created with, so
# NOTIFY_EMAIL_TO must be that address.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
# Optional. Defaults to Resend's test sender, onboarding@resend.dev.
NOTIFY_EMAIL_FROM=
# ---------------------------------------------------------------------------
# The public site
# ---------------------------------------------------------------------------
# The public https:// origin, no path (https://example.com). Canonical links,
# share previews (og:url, og:image), the sitemap and the enquiry email's link
# are built from it. Unset: each request's own host.
PUBLIC_SITE_URL=
# true opens the site to search engines. Anything else (the default) keeps
# them out: robots.txt disallows everything, every page says noindex, and
# there is no sitemap. Set at launch (docs/LAUNCH-CHECKLIST.md, item 21).
SITE_INDEXABLE=
