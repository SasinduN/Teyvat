# ---------------------------------------------------------------------------
# Teyvat / Travel Eye Sri Lanka
# Copy to `.env.local` and fill in with your own project's values.
# `.env.local` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# Supabase is only used by the admin panel and the enquiry form until they
# move onto /api. The public site renders without these.
#
# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase PUBLISHABLE key (new format, starts with `sb_publishable_`).
# Project Settings → API Keys → Publishable key.
# Safe to ship to the browser: every table is protected by Row Level Security.
#
# Do NOT use the legacy "anon" JWT (starts with `eyJ...`) — legacy keys are
# deprecated and will stop working at the end of 2026.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — never add a secret key with a VITE_ prefix, and never
# import one from `src/`. Vite inlines every VITE_* variable into the client
# bundle, which would publish the key to the world.
#
# The optional image-migration script (scripts/migrate-images.ts) reads the
# SECRET key (new format, starts with `sb_secret_`, replaces the legacy
# service_role JWT) from the shell environment, not from .env.local:
#   SUPABASE_SECRET_KEY=... npm run images:migrate
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# API tests (`npm test`). A local database of their own: the tests empty the
# users, sessions and login_attempts tables. They refuse to run unless this
# points at localhost, includes an explicit port, and names a database ending
# in _test. Use the port your own PostgreSQL listens on.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/teyvat_test

# ---------------------------------------------------------------------------
# Image uploads (Cloudflare R2). All five, or none: with none, the site runs
# and uploads say "not configured". Server-side only; never prefix with VITE_.
# The token needs Object Read & Write on this one bucket.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address, https:// (trailing slash optional).
R2_PUBLIC_BASE_URL=
