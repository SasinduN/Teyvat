node_modules
dist
dist-ssr
server/dist
*.local

# Environment — real keys must never be committed.
# Broad on purpose: DATABASE_URL and the R2 credentials live in these.
.env
.env.*
*.env
*.env.*
!/.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# Local audit artifacts
.audit-baseline/
.chrome-audit*/
.component-inventory.txt
.baseline-dom*.html

# Local archives and generated audit artifacts
backups/
__pycache__/
*.pyc
docs/qa-results/

# Review screenshots stay local (docs/reviews/<name>/); only the .md is committed.
docs/reviews/*/

# Design screenshots (npm run screenshots): attached to PRs on GitHub, never committed.
docs/screenshots/

# Database backups (npm run db:backup): production data, never committed.
# no-committed-backups.test.ts fails if anything here is tracked.
/backups/
*.dump
*.dump.partial
